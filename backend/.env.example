PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=scopesync
FIREBASE_PROJECT_ID=replace-with-your-firebase-project-id
FRONTEND_ORIGIN=http://localhost:3101

# Optional: enables AI project analysis and AI change-impact estimates.
# Get a key at https://aistudio.google.com/apikey - it stays on the server and is never sent to the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
